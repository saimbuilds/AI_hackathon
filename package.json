    "@sparticuz/chromium-min": "^153.0.0",
    "@supabase/supabase-js": "^2.118.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "linkedom": "^0.18.13",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "nodemailer": "^10.1.1",
    "p-limit": "^7.3.3",
    "puppeteer-core": "^25.14.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.14.0"
