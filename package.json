    "sources:build": "tsx scripts/build-sources.mts",
    "nightly": "tsx --env-file-if-exists=.env.local worker/nightly.ts",
    "load": "tsx --env-file-if-exists=.env.local scripts/load-test.mts",
    "email": "tsx --env-file-if-exists=.env.local worker/email.ts",
    "lab": "tsx --env-file-if-exists=.env.local worker/lab.ts",
    "press": "tsx --env-file-if-exists=.env.local worker/run.ts",
    "backfill": "tsx --env-file-if-exists=.env.local worker/backfill.ts",
    "scout": "tsx --env-file-if-exists=.env.local worker/scout.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@huggingface/transformers": "^4.3.1",
    "@mozilla/readability": "^0.6.0",
